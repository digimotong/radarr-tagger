# Copy to .env (or paste into your compose file) and fill in the required values.
# Docker Compose reads this automatically when it sits next to the compose file.

# --- Required -----------------------------------------------------------------
# Radarr instance URL, reachable from inside the container.
RADARR_URL=http://radarr:7878
# Radarr API key with write permissions (Settings -> General -> Security).
RADARR_API_KEY=your-api-key

# --- Optional -----------------------------------------------------------------
# Case-insensitive. One of DEBUG, INFO, WARNING, ERROR, CRITICAL; anything else
# aborts startup with "Configuration error".
LOG_LEVEL=INFO
# Score above which positive-score is applied (strictly greater-than).
SCORE_THRESHOLD=100
# Whole minutes between runs, minimum 1. 0 or negative aborts startup rather
# than spinning the loop.
INTERVAL_MINUTES=20
# Any value other than "true" leaves the feature disabled.
TAG_4K=false
TAG_MOTONG=false

# --- Notes --------------------------------------------------------------------
# Every Radarr HTTP request uses a 30 second timeout, so a stalled connection
# fails the cycle (retried after 5 minutes) instead of hanging forever.
